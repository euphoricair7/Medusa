# Copy to scripts/.env and adjust for your environment.
# Used by scripts/falco-daemonset-setup.sh (cluster Falco / Helm).

# Path to the Medusa repository (for medusa_rules.yaml)
MEDUSA_ROOT=/home/ubuntu/Medusa

# Webhook target — API must be reachable from cluster pods at this address
# MEDUSA_API_HOST=   # auto-detected node InternalIP if unset
MEDUSA_API_PORT=8000
MEDUSA_API_PATH=/alerts/falco

# Helm release
FALCO_RELEASE=falco
FALCO_NAMESPACE=falco
# FALCO_CHART_VERSION=9.1.0
FALCO_DRIVER_KIND=modern_ebpf

# Leave false unless you configure falcoctl to install the k8smeta plugin.
# Enabling without the plugin causes Falco to crash (libk8smeta.so not found).
ENABLE_K8S_META=false

# Preflight checks (set true only when debugging)
# SKIP_MEDUSA_CHECK=false
# SKIP_API_PREFLIGHT=false
